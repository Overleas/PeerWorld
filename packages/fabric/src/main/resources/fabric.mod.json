{
  "schemaVersion": 1,
  "id": "peerworld",
  "version": "${version}",
  "name": "PeerWorld",
  "description": "Free, decentralized peer-to-peer friend-hosted Minecraft worlds with seamless handoff and offline support.",
  "authors": [
    "Overleas",
    "PeerWorld Contributors"
  ],
  "contact": {
    "homepage": "https://peerworld.link",
    "sources": "https://github.com/overleas/peerworld",
    "issues": "https://github.com/overleas/peerworld/issues"
  },
  "license": "MIT",
  "icon": "peerworld_icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "link.sharedworld.fabric.SharedWorldFabricClient"
    ]
  },
  "mixins": [
    "sharedworld.mixins.json",
    "sharedworld-versioned.mixins.json"
  ],
  "provides": [
    "sharedworld"
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "${minecraftRange}",
    "java": ">=${javaVersion}",
    "fabric-api": "*"
  },
  "recommends": {
    "e4mc": ">=6.0.6 <7.0.0"
  }
}
